    "@vercel/blob": "2.3.0",
    "better-auth": "1.6.23",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
