# Valori usati da compose.yaml per lo sviluppo locale.
POSTGRES_DB="casahub"
POSTGRES_USER="casahub"
POSTGRES_PASSWORD="replace-with-a-local-random-password"
POSTGRES_PORT="5432"

# In produzione usa un PostgreSQL gestito in area europea e sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/casahub"
# Connessione diretta opzionale, usata da Prisma CLI per migrazioni e introspezione.
DATABASE_URL_UNPOOLED=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# In produzione la verifica email è sempre richiesta. Resend può essere
# collegato dal Vercel Marketplace; il mittente deve usare un dominio verificato.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
RESEND_API_KEY=""
AUTH_EMAIL_FROM="CasaHub <accesso@example.com>"

# Token di uno store Vercel Blob con accesso Private. Non usare NEXT_PUBLIC_*.
BLOB_READ_WRITE_TOKEN=""

# Solo per `pnpm db:seed`; non usare password di produzione.
SEED_OWNER_PASSWORD=""
SEED_TENANT_PASSWORD=""
