generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  TENANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum BillStatus {
  DRAFT
  DUE
  SCHEDULED
  PAID
  OVERDUE
  DISPUTED
}

enum ExpenseStatus {
  EXPECTED
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  SCHEDULED
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentStatus {
  QUARANTINED
  CLEAN
  REJECTED
}

enum Visibility {
  OWNER_ONLY
  SHARED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  memberships       ApartmentMembership[]
  sentInvitations   Invitation[]          @relation("InvitationSender")
  issueComments     IssueComment[]
  messages          Message[]
  uploadedFiles     Attachment[]
  notifications     Notification[]
  auditEvents       AuditEvent[]
  eventParticipants EventParticipant[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Apartment {
  id          String   @id @default(cuid())
  name        String
  addressLine String
  city        String
  postalCode  String?
  countryCode String   @default("IT")
  timezone    String   @default("Europe/Rome")
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        ApartmentMembership[]
  invitations        Invitation[]
  bills              Bill[]
  expenses           Expense[]
  rentSchedules      RentSchedule[]
  issues             Issue[]
  messageThreads     MessageThread[]
  calendarEvents     CalendarEvent[]
  documents          Document[]
  attachments        Attachment[]
  utilityConnections UtilityConnection[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
}

model ApartmentMembership {
  id          String           @id @default(cuid())
  apartmentId String
  userId      String
  role        MembershipRole
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  apartment   Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([apartmentId, userId])
  @@index([userId, status])
}

model Invitation {
  id          String           @id @default(cuid())
  apartmentId String
  email       String
  role        MembershipRole   @default(TENANT)
  status      InvitationStatus @default(PENDING)
  tokenHash   String           @unique
  expiresAt   DateTime
  invitedById String
  createdAt   DateTime         @default(now())
  apartment   Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([apartmentId, email])
}

model Bill {
  id          String       @id @default(cuid())
  apartmentId String
  supplier    String
  category    String
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("EUR")
  periodStart DateTime?
  periodEnd   DateTime?
  issuedAt    DateTime?
  dueAt       DateTime
  paidAt      DateTime?
  status      BillStatus   @default(DUE)
  shared      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  apartment   Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([apartmentId, dueAt])
  @@index([apartmentId, status])
}

model Expense {
  id          String          @id @default(cuid())
  apartmentId String
  title       String
  category    String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("EUR")
  dueAt       DateTime?
  paidAt      DateTime?
  status      ExpenseStatus   @default(EXPECTED)
  shared      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  apartment   Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  payments    PaymentRecord[]
  attachments Attachment[]

  @@index([apartmentId, status])
}

model RentSchedule {
  id          String    @id @default(cuid())
  apartmentId String
  label       String
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("EUR")
  dueDay      Int
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
}

model PaymentRecord {
  id        String   @id @default(cuid())
  expenseId String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, paidAt])
}

model Issue {
  id          String         @id @default(cuid())
  apartmentId String
  title       String
  description String
  category    String
  priority    IssuePriority  @default(MEDIUM)
  status      IssueStatus    @default(OPEN)
  createdById String
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  apartment   Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  comments    IssueComment[]
  attachments Attachment[]

  @@index([apartmentId, status])
  @@index([createdById])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

model MessageThread {
  id           String              @id @default(cuid())
  apartmentId  String
  title        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  apartment    Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  participants ThreadParticipant[]
  messages     Message[]

  @@index([apartmentId, updatedAt])
}

model ThreadParticipant {
  id       String        @id @default(cuid())
  threadId String
  userId   String
  readAt   DateTime?
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model CalendarEvent {
  id           String             @id @default(cuid())
  apartmentId  String
  title        String
  description  String?
  location     String?
  startsAt     DateTime
  endsAt       DateTime
  createdById  String
  issueId      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  apartment    Apartment          @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  participants EventParticipant[]

  @@index([apartmentId, startsAt])
}

model EventParticipant {
  id      String            @id @default(cuid())
  eventId String
  userId  String
  status  ParticipantStatus @default(PENDING)
  event   CalendarEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Document {
  id          String       @id @default(cuid())
  apartmentId String
  title       String
  category    String
  version     Int          @default(1)
  visibility  Visibility   @default(SHARED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  apartment   Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([apartmentId, category])
}

model Attachment {
  id           String           @id @default(cuid())
  apartmentId  String
  uploadedById String
  storageKey   String           @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String?
  status       AttachmentStatus @default(QUARANTINED)
  visibility   Visibility       @default(SHARED)
  billId       String?
  expenseId    String?
  issueId      String?
  documentId   String?
  createdAt    DateTime         @default(now())
  apartment    Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  bill         Bill?            @relation(fields: [billId], references: [id], onDelete: Cascade)
  expense      Expense?         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  issue        Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  document     Document?        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([apartmentId, status])
}

model UtilityConnection {
  id              String               @id @default(cuid())
  apartmentId     String
  provider        String
  encryptedSecret String
  connectedAt     DateTime             @default(now())
  revokedAt       DateTime?
  apartment       Apartment            @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  readings        ConsumptionReading[]

  @@index([apartmentId, provider])
}

model ConsumptionReading {
  id           String            @id @default(cuid())
  connectionId String
  measuredAt   DateTime
  value        Decimal           @db.Decimal(14, 4)
  unit         String
  source       String
  connection   UtilityConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, measuredAt, unit])
}

model Notification {
  id          String    @id @default(cuid())
  apartmentId String
  userId      String
  type        String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  apartmentId String
  actorId     String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([apartmentId, createdAt])
}
