# Valori usati da compose.yaml per lo sviluppo locale.
POSTGRES_DB="casahub"
POSTGRES_USER="casahub"
POSTGRES_PASSWORD="replace-with-a-local-random-password"
POSTGRES_PORT="5432"

# In produzione usa un PostgreSQL gestito in area europea e sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/casahub"
# Connessione diretta opzionale, usata da Prisma CLI per migrazioni e introspezione.
DATABASE_URL_UNPOOLED=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth: login, Calendar e Gmail. Il callback autorizzato è
# {BETTER_AUTH_URL}/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 32 byte casuali codificati base64, separati da BETTER_AUTH_SECRET.
# Esempio: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# Segreto usato esclusivamente da Vercel Cron per processare la outbox.
CRON_SECRET=""

# Opzionali: servono solo per recupero password e invio automatico degli inviti.
# Senza questi valori la registrazione e l'onboarding funzionano comunque;
# gli inviti possono essere condivisi copiando il link generato dall'app.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="CasaHub <accesso@example.com>"

# Token di uno store Vercel Blob con accesso Private. Non usare NEXT_PUBLIC_*.
BLOB_READ_WRITE_TOKEN=""

# Solo per `pnpm db:seed`; non usare password di produzione.
SEED_OWNER_PASSWORD=""
SEED_TENANT_PASSWORD=""
