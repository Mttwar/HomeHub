    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "prisma": "7.9.0",
    "tailwindcss": "4.3.3",
